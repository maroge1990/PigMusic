# PigMusic environment variables. Placeholders only; no real values.
# The server reads these from the process environment (it does not load .env
# itself). Docker Compose reads PIG_MUSIC_APPDATA from .env. Secrets
# (Fanart/ListenBrainz/slskd) live in appdata files, never here.

# Compose: host folder mounted as /data (compose.yaml)
PIG_MUSIC_APPDATA=./.localdata

# Appdata directory: SQLite database, snapshot, covers, private config
PIG_MUSIC_DATA=./.localdata/dev
# Music library root used for scanning, playback and publication
PIG_MUSIC_LIBRARY=/path/to/music
# Managed download workspace (default: <PIG_MUSIC_DATA>/downloads)
PIG_MUSIC_DOWNLOAD_ROOT=/path/to/music/.pig-music-work

# Public HTTPS origin used in invite links; must be a bare https:// origin
PIG_MUSIC_PUBLIC_ORIGIN=https://music.example.com
# Exact proxy IPs whose X-Forwarded-For is trusted (no ranges)
PIG_MUSIC_TRUSTED_PROXIES=127.0.0.1

# Background artwork/page pre-cache; use false for local development
PIG_MUSIC_PRELOAD=false
# Run the embedded slskd engine (true in the container)
PIG_MUSIC_EMBEDDED_ENGINE=false
# Start the engine without connecting to the Soulseek network
PIG_MUSIC_ENGINE_NO_CONNECT=false
# Monochrome API endpoint (public HTTPS)
PIG_MUSIC_MONOCHROME_API=https://tracks.monochrome.st
# Extra comma-separated Monochrome CDN hosts to allow
PIG_MUSIC_MONOCHROME_CDN_HOSTS=
# Server AAC device-copy cache budget in bytes (default 5 GiB)
PIG_DEVICE_COPY_CACHE_BYTES=5368709120

# Swift contract tests: URL of `python -m scripts.serve_contract_fixture`
PIG_CONTRACT_SERVER=http://127.0.0.1:8781

# Live household tools (scripts/deploy_release.py, deploy_unraid.py,
# benchmark_api.py) read these via scripts/household.py: from the process
# environment, else from the gitignored .private/household.env. The server
# never reads them. Placeholders only; real values stay in .private/.
PIG_MUSIC_UNRAID_SSH=root@<unraid-host>
PIG_MUSIC_UNRAID_ADDRESS=<unraid-lan-ip>
PIG_MUSIC_UNRAID_NAME=<unraid-server-name>
PIG_MUSIC_LAN_ADDRESS=<container-br0-ip>
PIG_MUSIC_LAN_URL=http://<container-br0-ip>:8765
PIG_MUSIC_TAILNET_ORIGIN=https://<tailnet-host>:10000
PIG_MUSIC_TAILNET_ADDRESS=<tailnet-ip>
PIG_MUSIC_LIVE_PUBLIC_ORIGIN=https://music.example.com
